<Project>
  <!-- Development uses sibling worktrees. Release commands select Packages explicitly. -->
  <PropertyGroup>
    <DarkspyreDependencyMode Condition="'$(DarkspyreDependencyMode)' == ''">Source</DarkspyreDependencyMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DarkspyreDependencyMode)' == 'Source'">
    <TensorSharpSourceRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../TensorSharp'))</TensorSharpSourceRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisLevelStyle>latest-none</AnalysisLevelStyle>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>Darkspyre Studios</Authors>
    <Company>Darkspyre Studios</Company>
    <Copyright>Copyright © 2026 Brandon Mathis. All rights reserved.</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DarkspyreStudios/Inference</RepositoryUrl>
    <Version>11.15.1-rc.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
