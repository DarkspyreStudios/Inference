<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>Darkspyre.Inference.Tensor.Image.Supra</AssemblyName>
    <Description>Supra2-IMG in-process image generation through TensorSharp.</Description>
    <PackageTags>ai;inference;image;supra;dit;tensorsharp</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TensorSharp.Backends.Cuda" GeneratePathProperty="true" />
    <PackageReference Include="TensorSharp.Models" />
    <PackageReference Include="Darkspyre.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Common/Darkspyre.Inference.Tensor.Common/Darkspyre.Inference.Tensor.Common.csproj" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Tensor.Image.Supra.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgTensorSharp_Backends_Cuda)/contentFiles/any/net10.0/native/ptx/*.ptx">
      <Link>cuda_kernels/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
