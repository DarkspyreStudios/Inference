<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Darkspyre.Inference.Tensor</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Description>In-process LLM, image, speech transcription, text embedding, and typed-decision contracts and engines for Darkspyre applications.</Description>
    <PackageTags>ai;inference;llm;image-generation;decision;whisper;speech;embedding;tensorsharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="..\Common\Darkspyre.Inference.Tensor.Common\Darkspyre.Inference.Tensor.Common.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Decision\Darkspyre.Inference.Tensor.Decision\Darkspyre.Inference.Tensor.Decision.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Decision\Darkspyre.Inference.Tensor.Decision.Laya\Darkspyre.Inference.Tensor.Decision.Laya.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Embedding\Darkspyre.Inference.Tensor.Embedding\Darkspyre.Inference.Tensor.Embedding.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Ggml\Darkspyre.Inference.Tensor.Ggml\Darkspyre.Inference.Tensor.Ggml.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Image\Darkspyre.Inference.Tensor.Image\Darkspyre.Inference.Tensor.Image.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Image\Darkspyre.Inference.Tensor.Image.Supra\Darkspyre.Inference.Tensor.Image.Supra.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\LLM\Darkspyre.Inference.Tensor.LLM\Darkspyre.Inference.Tensor.LLM.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\LLM\Darkspyre.Inference.Tensor.LLM.Qwen\Darkspyre.Inference.Tensor.LLM.Qwen.csproj" PrivateAssets="all" />
    <ProjectReference Include="../STT/Darkspyre.Inference.Tensor.STT/Darkspyre.Inference.Tensor.STT.csproj" PrivateAssets="all" />
    <ProjectReference Include="../STT/Darkspyre.Inference.Tensor.STT.Whisper/Darkspyre.Inference.Tensor.STT.Whisper.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Registry/Darkspyre.Inference.Tensor.Registry/Darkspyre.Inference.Tensor.Registry.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Darkspyre.ML.Tokenizers" />
    <PackageReference Include="Darkspyre.TensorSharp.Backends.Cuda" />
    <PackageReference Include="Darkspyre.TensorSharp.Backends.GGML" />
    <PackageReference Include="Darkspyre.TensorSharp.Chat" />
    <PackageReference Include="Darkspyre.TensorSharp.Models" />
    <PackageReference Include="Darkspyre.TensorSharp.Runtime" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" PrivateAssets="none" />
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" PrivateAssets="none" />
    <PackageReference Include="NAudio.Core" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\Common\Darkspyre.Inference.Tensor.Common\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Common.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Common\Darkspyre.Inference.Tensor.Common\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Common.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Decision\Darkspyre.Inference.Tensor.Decision\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Decision.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Decision\Darkspyre.Inference.Tensor.Decision\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Decision.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Decision\Darkspyre.Inference.Tensor.Decision.Laya\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Decision.Laya.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Decision\Darkspyre.Inference.Tensor.Decision.Laya\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Decision.Laya.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Embedding\Darkspyre.Inference.Tensor.Embedding\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Embedding.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Embedding\Darkspyre.Inference.Tensor.Embedding\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Embedding.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Ggml\Darkspyre.Inference.Tensor.Ggml\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Ggml.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Ggml\Darkspyre.Inference.Tensor.Ggml\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Ggml.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Image\Darkspyre.Inference.Tensor.Image\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Image.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Image\Darkspyre.Inference.Tensor.Image\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Image.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Image\Darkspyre.Inference.Tensor.Image.Supra\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Image.Supra.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Image\Darkspyre.Inference.Tensor.Image.Supra\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Image.Supra.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\LLM\Darkspyre.Inference.Tensor.LLM\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.LLM.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\LLM\Darkspyre.Inference.Tensor.LLM\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.LLM.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\LLM\Darkspyre.Inference.Tensor.LLM.Qwen\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.LLM.Qwen.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\LLM\Darkspyre.Inference.Tensor.LLM.Qwen\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.LLM.Qwen.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="../STT/Darkspyre.Inference.Tensor.STT/bin/$(Configuration)/$(TargetFramework)/Darkspyre.Inference.Tensor.STT.dll" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="../STT/Darkspyre.Inference.Tensor.STT/bin/$(Configuration)/$(TargetFramework)/Darkspyre.Inference.Tensor.STT.xml" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="../STT/Darkspyre.Inference.Tensor.STT.Whisper/bin/$(Configuration)/$(TargetFramework)/Darkspyre.Inference.Tensor.STT.Whisper.dll" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="../STT/Darkspyre.Inference.Tensor.STT.Whisper/bin/$(Configuration)/$(TargetFramework)/Darkspyre.Inference.Tensor.STT.Whisper.xml" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="../Registry/Darkspyre.Inference.Tensor.Registry/bin/$(Configuration)/$(TargetFramework)/Darkspyre.Inference.Tensor.Registry.dll" Pack="true" PackagePath="lib/$(TargetFramework)" />
    <None Include="../Registry/Darkspyre.Inference.Tensor.Registry/bin/$(Configuration)/$(TargetFramework)/Darkspyre.Inference.Tensor.Registry.xml" Pack="true" PackagePath="lib/$(TargetFramework)" />
  </ItemGroup>
  <!-- Whisper's imported targets mark native output files Pack=true. They belong to its public
       runtime NuGet, not this product archive. Preserve build output copying and the dependency. -->
  <Target Name="DoNotRepackWhisperRuntime" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Update="@(None)" Condition="'%(None.DefiningProjectName)' == 'Whisper.net.Runtime' Or '%(None.DefiningProjectName)' == 'Whisper.net.Runtime.Metal'" Pack="false" />
    </ItemGroup>
  </Target>
</Project>
