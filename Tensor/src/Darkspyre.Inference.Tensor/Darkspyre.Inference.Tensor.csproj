    <None Include="..\Decision\Darkspyre.Inference.Tensor.Decision.Laya\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Decision.Laya.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
