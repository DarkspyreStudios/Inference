  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Darkspyre.Persistence" />
    <PackageReference Include="Darkspyre.ML.Tokenizers" />
    <PackageReference Include="Darkspyre.TensorSharp.Backends.Cuda" />
    <PackageReference Include="Darkspyre.TensorSharp.Chat" />
    <PackageReference Include="Darkspyre.TensorSharp.Models" />
    <PackageReference Include="Darkspyre.TensorSharp.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\Common\Darkspyre.Inference.Tensor.Common\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Common.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Common\Darkspyre.Inference.Tensor.Common\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Common.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Decision\Darkspyre.Inference.Tensor.Decision\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Tensor.Decision.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
