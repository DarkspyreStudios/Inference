    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Description>In-process LLM, image, and typed-decision contracts and engines for Darkspyre applications.</Description>
    <PackageTags>ai;inference;llm;image-generation;decision;tensorsharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="..\Common\Darkspyre.Inference.Tensor.Common\Darkspyre.Inference.Tensor.Common.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Decision\Darkspyre.Inference.Tensor.Decision\Darkspyre.Inference.Tensor.Decision.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Decision\Darkspyre.Inference.Tensor.Decision.Laya\Darkspyre.Inference.Tensor.Decision.Laya.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Image\Darkspyre.Inference.Tensor.Image\Darkspyre.Inference.Tensor.Image.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Image\Darkspyre.Inference.Tensor.Image.Supra\Darkspyre.Inference.Tensor.Image.Supra.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\LLM\Darkspyre.Inference.Tensor.LLM\Darkspyre.Inference.Tensor.LLM.csproj" PrivateAssets="all" />
