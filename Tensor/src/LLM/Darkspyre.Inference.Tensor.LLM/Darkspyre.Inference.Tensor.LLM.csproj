<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Darkspyre.Inference.Tensor.LLM</PackageId>
    <AssemblyName>Darkspyre.Inference.Tensor.LLM</AssemblyName>
    <Description>In-process Qwen GGUF inference through TensorSharp using Darkspyre typed LLM contracts.</Description>
    <PackageTags>ai;inference;llm;qwen;gguf;tensorsharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Darkspyre.TensorSharp.Backends.Cuda" GeneratePathProperty="true" />
    <PackageReference Include="Darkspyre.TensorSharp.Chat" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="..\..\Common\Darkspyre.Inference.Tensor.Common\Darkspyre.Inference.Tensor.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgDarkspyre_TensorSharp_Backends_Cuda)/contentFiles/any/net10.0/native/ptx/*.ptx">
      <Link>cuda_kernels/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
