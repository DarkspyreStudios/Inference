<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <AssemblyName>Darkspyre.Inference.Tensor.LLM.Qwen</AssemblyName>
    <Description>Qwen GGUF in-process LLM inference through TensorSharp.</Description>
    <PackageTags>ai;inference;llm;qwen;gguf;tensorsharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TensorSharp.Backends.Cuda" GeneratePathProperty="true" />
    <PackageReference Include="TensorSharp.Backends.GGML" />
    <PackageReference Include="TensorSharp.Chat" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Tensor.LLM.Qwen.Tests" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Tensor.Registry" />
    <ProjectReference Include="../../Common/Darkspyre.Inference.Tensor.Common/Darkspyre.Inference.Tensor.Common.csproj" />
    <ProjectReference Include="..\..\Ggml\Darkspyre.Inference.Tensor.Ggml\Darkspyre.Inference.Tensor.Ggml.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgTensorSharp_Backends_Cuda)/contentFiles/any/net10.0/native/ptx/*.ptx">
      <Link>cuda_kernels/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons/*.svg" LogicalName="Icons/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
