<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>Darkspyre.Inference.Tensor.Decision.Laya</AssemblyName>
    <Description>Laya in-process typed-decision inference through TensorSharp.</Description>
    <PackageTags>ai;inference;decision;laya;modernbert;tensorsharp</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Darkspyre.TensorSharp.Backends.Cuda" GeneratePathProperty="true" />
    <PackageReference Include="Darkspyre.TensorSharp.Models" />
    <PackageReference Include="Darkspyre.ML.Tokenizers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Darkspyre.Inference.Tensor.Decision\Darkspyre.Inference.Tensor.Decision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Tensor.Decision.Laya.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(PkgDarkspyre_TensorSharp_Backends_Cuda)/contentFiles/any/net10.0/native/ptx/*.ptx">
      <Link>cuda_kernels/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
