@* The selected model's install state under its choice, with the actions that change it. *@
<Alert Variant="@Variant" ShowIcon="false" Title="@Status.Name" Class="inference-install-card" aria-label="@Label">
    @switch (Status.State)
    {
        case SetupInstallState.Installed:
            <SetupInstallChip State="SetupInstallState.Installed" Text="@($"Installed in {Status.Location}")" />
            <div class="inference-install-card__detail-line">
                <p class="inference-install-card__detail">Ready to load. @Files, @SetupByteSize.Format(Status.Size), @(Status.License).</p>
                @if (Reveal.HasDelegate)
                {
                    <Button Variant="Button.ButtonVariant.Ghost" aria-label="Show the model folder"
                            OnClick="() => Reveal.InvokeAsync(Status.Location)">Show</Button>
                }
            </div>
            break;
        case SetupInstallState.NotDownloaded:
            <SetupInstallChip State="SetupInstallState.NotDownloaded" Text="Not downloaded" />
            <p>This model is not in @Status.Location. The engine cannot load it until it is downloaded.</p>
            break;
        case SetupInstallState.NotSupported:
            <SetupInstallChip State="SetupInstallState.NotSupported" Text="Not supported" />
            <p>@Status.UnsupportedReason</p>
            break;
        default:
            <SetupInstallChip State="SetupInstallState.FilesMissing" Text="Files missing" />
            <p>@Status.MissingFile is missing from the model store.</p>
            break;
    }
    @if (Status.Actions.Count > 0)
    {
        <div class="inference-install-card__actions">
            @foreach (var action in Status.Actions)
            {
                <Button Variant="Button.ButtonVariant.Outline" Disabled="@(Disabled || !action.IsEnabled)"
                        OnClick="() => Run.InvokeAsync(action)">@action.DisplayName</Button>
                @if (!action.IsEnabled && !string.IsNullOrWhiteSpace(action.UnavailableReason))
                { <span class="inference-install-card__detail">@action.UnavailableReason</span> }
            }
        </div>
    }
</Alert>

@code {
    /// <summary>The install state the card shows, with its buttons.</summary>
    [Parameter, EditorRequired] public SetupInstallStatus Status { get; set; } = default!;
    /// <summary>The field's display name; it names the card for assistive technology.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    /// <summary>True disables the buttons, as while the editor saves or runs an action.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Raised with the action a button names; the editor runs it like any other action.</summary>
    [Parameter] public EventCallback<SetupActionDescriptor> Run { get; set; }
    /// <summary>Raised with the store folder when the person asks to see an installed model's files.</summary>
    [Parameter] public EventCallback<string> Reveal { get; set; }

    private string Files => Status.FileCount == 1 ? "1 file" : $"{Status.FileCount} files";

    private Alert.AlertVariant Variant => Status.State switch
    {
        SetupInstallState.Installed => Alert.AlertVariant.Success,
        SetupInstallState.NotDownloaded => Alert.AlertVariant.Warning,
        _ => Alert.AlertVariant.Destructive
    };
}
