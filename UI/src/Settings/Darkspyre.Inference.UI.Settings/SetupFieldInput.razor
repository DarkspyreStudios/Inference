@using Darkspyre.Inference.Common
@implements IDisposable

@* Renders one setup field with the input that fits its kind, applies each edit to the settings and shows the field's first error. *@
@if (Field.Description.IsVisible)
{
    @if (Field is SetupRepeatableGroupField group)
    {
        <fieldset class="inference-settings-editor__repeatable" disabled="@Unavailable">
            <legend>@Field.Description.DisplayName</legend>
            @foreach (var row in group.Rows)
            {
                <div class="inference-settings-editor__row" @key="row.Id">
                    @foreach (var child in row.Fields.Where(item => item.Description.IsVisible))
                    {
                        <SetupFieldInput @key="child.Description.Id" Field="child" Settings="Settings" Manager="Manager"
                                         EditVersion="EditVersion" Host="Host" Issues="Issues" Edited="Edited" Disabled="Disabled" />
                    }
                    <Button Variant="Button.ButtonVariant.Ghost" Disabled="@Unavailable"
                            OnClick="() => ApplyAsync(group.Remove(row.Id))">Remove row</Button>
                </div>
            }
            <Button Variant="Button.ButtonVariant.Outline" Disabled="@Unavailable"
                    OnClick="() => ApplyAsync(group.Add())">Add row</Button>
        </fieldset>
    }
    else if (Field is SetupBooleanField boolean)
    {
        <label class="inference-settings-editor__boolean">
            <Checkbox Checked="@boolean.Value" CheckedChanged="@(value => ApplyAsync(boolean.SetValue(value)))"
                      Disabled="@Unavailable" />
            <span>@Field.Description.DisplayName</span>
        </label>
        @if (!string.IsNullOrWhiteSpace(Field.Description.HelpText)) { <p>@Field.Description.HelpText</p> }
        @if (FieldError is not null) { <p role="alert">@FieldError</p> }
    }
    else
    {
        <FormField Label="@Field.Description.DisplayName" HelpText="@Field.Description.HelpText"
                   Required="@Field.Description.IsRequired" Error="@FieldError">
            @switch (Field)
            {
                case SetupTextField text:
                    <Input Type="@(SensitiveInput ? "password" : "text")" Value="@_value" ValueChanged="@(value => SetTextAsync(text, value))"
                           Disabled="@Unavailable" MaxLength="@text.MaximumLength" />
                    @if (text.PathSelection is not null && Host is IInferenceSettingsPathPicker)
                    { <Button Variant="Button.ButtonVariant.Outline" Disabled="@(Unavailable || _picking)" OnClick="PickPathAsync">Browse…</Button> }
                    break;
                case SetupUriField uri:
                    <Input Value="@_value" ValueChanged="@(value => SetUriAsync(uri, value))"
                           Disabled="@Unavailable" />
                    break;
                case SetupExecutableField executable:
                    <Input Value="@_value" ValueChanged="@(value => SetExecutableAsync(executable, value))"
                           Disabled="@Unavailable" Placeholder="@executable.DefaultValue.Value" />
                    @if (Host is IInferenceSettingsPathPicker)
                    { <Button Variant="Button.ButtonVariant.Outline" Disabled="@(Unavailable || _picking)" OnClick="PickPathAsync">Browse…</Button> }
                    break;
                case SetupIntegerField integer:
                    <SetupNumberInput T="long" Text="@_value" Minimum="integer.Minimum" Maximum="integer.Maximum"
                                      Required="integer.Description.IsRequired" Label="@integer.Description.DisplayName"
                                      Invalid="@(FieldError is not null)" Disabled="@Unavailable" Edited="@(edit => SetNumberAsync(integer, edit))" />
                    break;
                case SetupDecimalField number:
                    <SetupNumberInput T="decimal" Text="@_value" Minimum="number.Minimum" Maximum="number.Maximum" Step="number.Step"
                                      Required="number.Description.IsRequired" Label="@number.Description.DisplayName"
                                      Invalid="@(FieldError is not null)" Disabled="@Unavailable" Edited="@(edit => SetNumberAsync(number, edit))" />
                    break;
                case SetupChoiceField choice:
                    @* The combobox filters loaded choices itself; provider search matters only while more remain. *@
                    @if (choice.Capabilities.SupportsSearch != InferenceSupport.Unsupported && (_continuation is not null || _search.Length > 0))
                    {
                    <div class="inference-settings-editor__choice-actions">
                        <Input @bind-Value="_search" Placeholder="Search choices" Disabled="@Unavailable" />
                        <Button Variant="Button.ButtonVariant.Ghost" Disabled="@(_loading || Unavailable)"
                                OnClick="SearchChoicesAsync">Search</Button>
                    </div>
                    }
                    @if (choice.Capabilities.SupportsSearch == InferenceSupport.Unsupported && choice.Capabilities.SupportsPaging == InferenceSupport.Unsupported && !choice.AllowsManualEntry)
                    {
                        <Select Value="@_value" ValueChanged="@(value => SetChoiceAsync(choice, value))" Disabled="@Unavailable" @bind-Open="_choiceOpen">
                            <SelectTrigger />
                            <SelectContent>
                                @foreach (var option in _choices)
                                { <SelectItem Value="@option.Value">@option.DisplayName</SelectItem> }
                            </SelectContent>
                        </Select>
                    }
                    else if (_choices.Count > 0 || !choice.AllowsManualEntry)
                    {
                        <Combobox Value="@_value" ValueChanged="@(value => SetChoiceAsync(choice, value))"
                                  @bind-Open="_choiceOpen" Creatable="@choice.AllowsManualEntry" Disabled="@Unavailable">
                            <ComboboxInput Placeholder="Choose or search" />
                            <ComboboxContent>
                                @foreach (var option in _choices)
                                {
                                    @* Providers can give distinct values one display name, so the value names the choice. *@
                                    <ComboboxItem Value="@option.Value" SearchValue="@ChoiceSearchText(option)">
                                        @option.DisplayName
                                        @if (option.DisplayName != option.Value)
                                        { <span class="inference-settings-editor__choice-value">@option.Value</span> }
                                    </ComboboxItem>
                                }
                                @if (choice.AllowsManualEntry) { <ComboboxCreate /> }
                            </ComboboxContent>
                        </Combobox>
                    }
                    @if (_choices.Count == 0 && choice.AllowsManualEntry)
                    { <Input Value="@_value" ValueChanged="@(value => SetChoiceAsync(choice, value))" Disabled="@Unavailable" /> }
                    <div class="inference-settings-editor__choice-actions">
                        @if (choice.Capabilities.SupportsRefresh != InferenceSupport.Unsupported)
                        { <Button Variant="Button.ButtonVariant.Ghost" Disabled="@(_loading || Unavailable)"
                                  OnClick="RefreshChoicesAsync">Refresh choices</Button> }
                        @if (_continuation is not null && choice.Capabilities.SupportsPaging != InferenceSupport.Unsupported)
                        { <Button Variant="Button.ButtonVariant.Ghost" Disabled="@(_loading || Unavailable)" OnClick="LoadMoreAsync">Load more</Button> }
                    </div>
                    @if (_loading) { <p role="status">Loading choices…</p> }
                    @if (_choiceIssue is not null) { <p role="status">@_choiceIssue</p> }
                    break;
                case SetupSecretField secret:
                    <p>@SecretState(secret)</p>
                    <div class="inference-settings-editor__secret-actions">
                        <Button Variant="Button.ButtonVariant.Ghost" Disabled="@Unavailable"
                                OnClick="() => SetSecretAsync(secret, SetupSecretEdit.Keep)">Keep</Button>
                        <Button Variant="Button.ButtonVariant.Ghost" Disabled="@Unavailable"
                                OnClick="() => SetSecretAsync(secret, SetupSecretEdit.Clear)">Clear</Button>
                    </div>
                    <Input Type="password" Value="@_secret" ValueChanged="SetPendingSecretAsync"
                           Disabled="@Unavailable" Placeholder="New secret" />
                    <Button Variant="Button.ButtonVariant.Outline" Disabled="@(Unavailable || secret.Description.IsRequired && string.IsNullOrEmpty(_secret))"
                            OnClick="() => ReplaceSecretAsync(secret)">Replace secret</Button>
                    break;
            }
        </FormField>
    }
}

@code {
    /// <summary>The setup field this input shows and edits.</summary>
    [Parameter, EditorRequired] public SetupField Field { get; set; } = default!;
    /// <summary>The host that authorizes choice loading and, when it picks paths, shows a Browse button.</summary>
    [Parameter, EditorRequired] public IInferenceSettingsInteractionHost Host { get; set; } = default!;
    /// <summary>The provider settings the field belongs to.</summary>
    [Parameter, EditorRequired] public InferenceSettings Settings { get; set; } = default!;
    /// <summary>The manager that loads the field's choices.</summary>
    [Parameter, EditorRequired] public IInferenceSettingsManager Manager { get; set; } = default!;
    /// <summary>The page's count of local edits. A choice result requested at an earlier count is dropped.</summary>
    [Parameter] public long EditVersion { get; set; }
    /// <summary>The editor's issues; the first error naming this field is shown under it.</summary>
    [Parameter] public IReadOnlyList<SetupIssue> Issues { get; set; } = [];
    /// <summary>Raised with the result after each edit is applied to the field.</summary>
    [Parameter] public EventCallback<SetupEditResult> Edited { get; set; }
    /// <summary>True makes the field read only, as while the editor saves or runs an action.</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>True masks a text field's input and keeps the typed text when parameters are set again.</summary>
    [Parameter] public bool SensitiveInput { get; set; }
    [CascadingParameter] private SetupEditorInputState? EditorInputs { get; set; }

    private readonly SetupEditorInputState _standaloneInputs = new();
    private SetupEditorInputState.Input Input => (EditorInputs ?? _standaloneInputs).Get(Field.Description.Id);
    private string _value { get => Input.Text; set { Input.Text = value; Input.Pending = true; } }
    private string _secret { get => Input.Secret; set => Input.Secret = value; }
    private string? _choiceIssue;
    private List<SetupChoice> _choices = [];
    private string? _continuation;
    private string _search = string.Empty;
    private bool _loading, _choiceOpen;
    private bool _disposed;
    private bool _picking;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _choiceCancellation;
    private long _choiceGeneration;
    private long _requestedVersion = -1;
    private long _loadedVersion = -1;
    private bool _wasUnavailable;
    private bool Unavailable => Disabled || Field.Description.IsReadOnly || !Field.Description.IsEnabled || !Field.Description.IsVisible;

    private async Task PickPathAsync()
    {
        if (Unavailable || _picking || Host is not IInferenceSettingsPathPicker picker) return;
        SetupField field = Field;
        long version = EditVersion;
        string previous = _value;
        SetupPathSelectionKind kind = field is SetupTextField text ? text.PathSelection!.Value : SetupPathSelectionKind.File;
        _picking = true;
        try
        {
            string? value = await picker.SelectPathAsync(kind, previous, _lifetime.Token);
            if (value is null || _disposed || Unavailable || version != EditVersion || !ReferenceEquals(field, Field) || _value != previous) return;
            if (field is SetupTextField path) await SetTextAsync(path, value);
            else if (field is SetupExecutableField executable) await SetExecutableAsync(executable, value);
        }
        catch (OperationCanceledException) { }
        catch (Exception) when (!_disposed) { await InvalidAsync("The host could not select a path. Enter it manually or try again."); }
        finally { _picking = false; }
    }
    private string? FieldError => Input.Issues.FirstOrDefault(issue => issue.Severity == SetupIssueSeverity.Error)?.Message
        ?? Issues.FirstOrDefault(issue => issue.FieldId == Field.Description.Id && issue.Severity == SetupIssueSeverity.Error)?.Message;

    private static string ChoiceSearchText(SetupChoice choice) =>
        choice.DisplayName == choice.Value ? choice.Value : choice.DisplayName + " " + choice.Value;

    private static string SecretState(SetupSecretField field) => field.Change switch
    {
        SetupSecretEditKind.Clear => "The saved secret will be cleared when settings are saved.",
        SetupSecretEditKind.Replace => "The secret will be replaced when settings are saved.",
        _ => field.HasValue ? "A secret is saved." : "No secret is saved."
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!Input.Initialized || !Input.Pending && !SensitiveInput)
        {
            Input.Text = Field switch
            {
                SetupTextField value => value.Value,
                SetupUriField value => value.Value?.ToString() ?? string.Empty,
                SetupExecutableField value => value.Value.Value,
                SetupIntegerField value => value.Value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty,
                SetupDecimalField value => value.Value?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty,
                SetupChoiceField value => value.Value,
                _ => string.Empty
            };
            Input.Initialized = true;
        }
        bool becameAvailable = _wasUnavailable && !Unavailable;
        _wasUnavailable = Unavailable;
        if (Field is SetupChoiceField && (_requestedVersion != EditVersion || becameAvailable))
        {
            _requestedVersion = EditVersion;
            await LoadChoicesAsync(reset: true);
        }
    }

    private async Task ApplyAsync(SetupEditResult result)
    {
        if (_disposed) { return; }
        Input.Pending = result.State != SetupEditState.Applied;
        Input.Issues = result.Issues.Count > 0 ? result.Issues : Input.Pending
            ? [new("input-" + result.State.ToString().ToLowerInvariant(), "The edit was not applied. Review the current settings and try again.", Field.Description.Id)] : [];
        await Edited.InvokeAsync(result);
    }

    private Task SetTextAsync(SetupTextField field, string? value)
    {
        _value = value ?? string.Empty;
        return ApplyAsync(field.SetValue(_value));
    }

    private Task SetExecutableAsync(SetupExecutableField field, string? value)
    {
        _value = value ?? string.Empty;
        return ApplyAsync(field.SetValue(new(_value)));
    }

    private Task SetChoiceAsync(SetupChoiceField field, string? value)
    {
        _value = value ?? string.Empty;
        return ApplyAsync(field.SetValue(_value));
    }

    private Task SetUriAsync(SetupUriField field, string? value)
    {
        value ??= string.Empty;
        _value = value;
        if (value.Length > 0 && !Uri.TryCreate(value, UriKind.Absolute, out _))
        { return InvalidAsync("Enter an absolute URL."); }
        return ApplyAsync(field.SetValue(value.Length == 0 ? null : new Uri(value, UriKind.Absolute)));
    }

    private Task SetNumberAsync<T>(SetupValueField<T?> field, SetupNumberEdit<T> edit) where T : struct
    {
        _value = edit.Text;
        return edit.Error is null ? ApplyAsync(field.SetValue(edit.Value)) : InvalidAsync(edit.Error);
    }

    private Task InvalidAsync(string message) => ApplyAsync(new(SetupEditState.Invalid,
        [new("input-invalid", message, Field.Description.Id)]));

    private Task SetPendingSecretAsync(string? value)
    {
        _secret = value ?? string.Empty;
        Input.Pending = _secret.Length != 0;
        Input.Issues = [];
        return Edited.InvokeAsync(new(SetupEditState.Applied, []));
    }

    private async Task ReplaceSecretAsync(SetupSecretField field)
    {
        SetupEditResult result = field.SetValue(SetupSecretEdit.Replace(_secret));
        if (result.State == SetupEditState.Applied) { _secret = string.Empty; }
        await ApplyAsync(result);
    }

    private async Task SetSecretAsync(SetupSecretField field, SetupSecretEdit change)
    {
        _secret = string.Empty;
        await ApplyAsync(field.SetValue(change));
    }

    private Task LoadMoreAsync() => _loading || _loadedVersion != EditVersion ? Task.CompletedTask : LoadChoicesAsync(reset: false);

    private Task SearchChoicesAsync() => RefreshChoicesAsync();

    private Task RefreshChoicesAsync() => LoadChoicesAsync(reset: true);

    private async Task LoadChoicesAsync(bool reset)
    {
        long generation = ++_choiceGeneration;
        _choiceCancellation?.Cancel();
        if (reset) { _choices = []; _continuation = null; _loadedVersion = -1; }
        _loading = false;
        if (Field is not SetupChoiceField choice || Unavailable || _disposed) { return; }
        // The values this query reads; a result that arrives after a later edit is dropped.
        long version = EditVersion;
        string search = _search;
        string? continuation = _continuation;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _choiceCancellation = cancellation;
        _loading = true;
        _choiceIssue = null;
        try
        {
            if (choice.ChoiceSideEffects != SetupSideEffect.None
                && !await Host.AuthorizeAsync("Load " + choice.Description.DisplayName, choice.ChoiceSideEffects, cancellation.Token))
            { if (IsCurrent()) { _choiceIssue = "Choice loading was not authorized."; } return; }
            if (!IsCurrent()) { return; }
            SetupChoicePage page = await Manager.QueryChoicesAsync(Settings, choice.Description.Id, new(search, continuation,
                choice.Capabilities.SupportsPaging != InferenceSupport.Unsupported ? 50 : 200), cancellation.Token);
            if (!IsCurrent()) { return; }
            if (page.State == SetupChoiceState.Completed)
            {
                _choices = _choices.Concat(page.Choices).DistinctBy(item => item.Value).ToList();
                _continuation = page.Continuation;
                _loadedVersion = version;
                if (page.Continuation is not null && choice.Capabilities.SupportsPaging == InferenceSupport.Unsupported)
                { _choiceIssue = "The provider returned an incomplete bounded list."; }
            }
            else { _choiceIssue = page.Issues?.FirstOrDefault()?.Message ?? page.State.ToString(); }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested) { }
        catch (Exception) { if (IsCurrent()) { _choiceIssue = "Choices could not be loaded."; } }
        finally
        {
            if (generation == _choiceGeneration) { _loading = false; }
            if (ReferenceEquals(_choiceCancellation, cancellation)) { _choiceCancellation = null; }
        }
        bool IsCurrent() => !_disposed && !cancellation.IsCancellationRequested && generation == _choiceGeneration && version == EditVersion;
    }

    public void Dispose()
    {
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        _standaloneInputs.Clear();
        GC.SuppressFinalize(this);
    }
}
