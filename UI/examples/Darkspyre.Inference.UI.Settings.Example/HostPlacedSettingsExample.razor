@using Darkspyre.Inference.Common.Setup
@using Darkspyre.Inference.Connect.Image
@using Darkspyre.Inference.Connect.LLM
@using Darkspyre.Inference.Setup.Examples
@using Darkspyre.Inference.Tensor.Common
@using Darkspyre.Inference.UI.Settings
@using Lumeo
@implements IAsyncDisposable

<section aria-label="Example host provider settings">
    <nav aria-label="Configured provider editors">
        @foreach (IInferenceSetupSession session in _sessions)
        {
            <Button Variant="Button.ButtonVariant.Ghost"
                    OnClick="() => _selected = session">@session.Snapshot.Definition.Implementation.DisplayName</Button>
        }
    </nav>
    @if (_selected is not null)
    {
        <InferenceSettingsEditor @key="_selected" Session="_selected" Host="Interactions"
                                 CommitCompleted="OnCommittedAsync" />
    }
</section>

@code {
    [Parameter, EditorRequired] public LlmProviderService LlmProviders { get; set; } = default!;
    [Parameter, EditorRequired] public ImageProviderService ImageProviders { get; set; } = default!;
    [Parameter, EditorRequired] public ITensorModelPackManager Packs { get; set; } = default!;
    [Parameter, EditorRequired] public IImageWorkflowChoiceSource Workflows { get; set; } = default!;
    [Parameter, EditorRequired] public ISetupCommitTarget<LlmSetupChanges> LlmCommit { get; set; } = default!;
    [Parameter, EditorRequired] public ISetupCommitTarget<ImageSetupChanges> ImageCommit { get; set; } = default!;
    [Parameter, EditorRequired] public ISetupCommitTarget<TensorSetupChanges> TensorCommit { get; set; } = default!;
    [Parameter, EditorRequired] public IInferenceSettingsInteractionHost Interactions { get; set; } = default!;
    [Parameter] public EventCallback<SetupCommitResult> CommitCompleted { get; set; }

    private IReadOnlyList<IInferenceSetupSession> _sessions = [];
    private IInferenceSetupSession? _selected;

    protected override async Task OnInitializedAsync()
    {
        // The example host chooses how to list and place editors. The library renders one session.
        _sessions = await SetupCompositionExample.CreateDraftsAsync(LlmProviders, ImageProviders, Packs,
            Workflows, LlmCommit, ImageCommit, TensorCommit);
        _selected = _sessions.FirstOrDefault();
    }

    private Task OnCommittedAsync(SetupCommitResult result) => CommitCompleted.InvokeAsync(result);

    public async ValueTask DisposeAsync()
    {
        foreach (IInferenceSetupSession session in _sessions) { await session.DisposeAsync(); }
        GC.SuppressFinalize(this);
    }
}
