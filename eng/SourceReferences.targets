<Project>
  <!--
    Source mode for consumers of the Inference packages. A consuming repository imports this file from its
    Directory.Build.targets when InferenceSourceRoot names an Inference checkout. Each Darkspyre.Inference.*
    PackageReference then becomes ProjectReferences to the projects that package carries:

      Darkspyre.Inference.Common       Common/src/Darkspyre.Inference.Common
      Darkspyre.Inference.Connect      the retained Image, TTS and Audio projects
      Darkspyre.Inference.Tensor.*     the named Tensor library project
      Darkspyre.Inference.UI.Settings.*  the named UI.Settings project (Core, Avalonia or Blazor)

    The packaging projects reference their bundled projects with PrivateAssets="all", so a reference to a packaging
    project would hide the bundled assemblies from the consumer. The consumer references the bundled projects instead.
    Each ProjectReference keeps the PackageReference's ExcludeAssets and PrivateAssets. ExcludeAssets "runtime" also sets
    Private="false", so the output is not copied, and "all" also sets ReferenceOutputAssembly="false".
  -->
  <PropertyGroup>
    <_InferenceSourceRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(InferenceSourceRoot)'))'))</_InferenceSourceRoot>
  </PropertyGroup>

  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Common'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Common/src/Darkspyre.Inference.Common/Darkspyre.Inference.Common.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Common')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Common')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Common" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/Image/Darkspyre.Inference.Connect.Image/Darkspyre.Inference.Connect.Image.csproj;$(_InferenceSourceRoot)Connect/src/TTS/Darkspyre.Inference.Connect.TTS/Darkspyre.Inference.Connect.TTS.csproj;$(_InferenceSourceRoot)Connect/src/Audio/Darkspyre.Inference.Connect.Audio/Darkspyre.Inference.Connect.Audio.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Common'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/Common/Darkspyre.Inference.Tensor.Common/Darkspyre.Inference.Tensor.Common.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Common')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Common')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.Common" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Decision.Laya'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/Decision/Darkspyre.Inference.Tensor.Decision.Laya/Darkspyre.Inference.Tensor.Decision.Laya.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Decision.Laya')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Decision.Laya')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.Decision.Laya" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Embedding'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/Embedding/Darkspyre.Inference.Tensor.Embedding/Darkspyre.Inference.Tensor.Embedding.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Embedding')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Embedding')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.Embedding" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Embedding.Gemma'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/Embedding/Darkspyre.Inference.Tensor.Embedding.Gemma/Darkspyre.Inference.Tensor.Embedding.Gemma.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Embedding.Gemma')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Embedding.Gemma')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.Embedding.Gemma" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Ggml'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/Ggml/Darkspyre.Inference.Tensor.Ggml/Darkspyre.Inference.Tensor.Ggml.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Ggml')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Ggml')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.Ggml" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Image.Supra'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/Image/Darkspyre.Inference.Tensor.Image.Supra/Darkspyre.Inference.Tensor.Image.Supra.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Image.Supra')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Image.Supra')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.Image.Supra" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.LLM.Qwen'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/LLM/Darkspyre.Inference.Tensor.LLM.Qwen/Darkspyre.Inference.Tensor.LLM.Qwen.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.LLM.Qwen')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.LLM.Qwen')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.LLM.Qwen" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Registry'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/Registry/Darkspyre.Inference.Tensor.Registry/Darkspyre.Inference.Tensor.Registry.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Registry')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.Registry')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.Registry" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.STT.Whisper'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Tensor/src/STT/Darkspyre.Inference.Tensor.STT.Whisper/Darkspyre.Inference.Tensor.STT.Whisper.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.STT.Whisper')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Tensor.STT.Whisper')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Tensor.STT.Whisper" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Core'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)UI/src/Settings/Darkspyre.Inference.UI.Settings.Core/Darkspyre.Inference.UI.Settings.Core.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Core')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Core')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.UI.Settings.Core" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Avalonia'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)UI/src/Settings/Darkspyre.Inference.UI.Settings.Avalonia/Darkspyre.Inference.UI.Settings.Avalonia.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Avalonia')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Avalonia')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.UI.Settings.Avalonia" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Blazor'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)UI/src/Settings/Darkspyre.Inference.UI.Settings.Blazor/Darkspyre.Inference.UI.Settings.Blazor.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Blazor')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.UI.Settings.Blazor')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.UI.Settings.Blazor" />
  </ItemGroup>

  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Common'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Common')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Common')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect.Common" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Codex'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/Codex/Darkspyre.Inference.Connect.Codex/Darkspyre.Inference.Connect.Codex.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Codex')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Codex')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect.Codex" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Claude'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/Claude/Darkspyre.Inference.Connect.Claude/Darkspyre.Inference.Connect.Claude.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Claude')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Claude')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect.Claude" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Antigravity'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/Antigravity/Darkspyre.Inference.Connect.Antigravity/Darkspyre.Inference.Connect.Antigravity.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Antigravity')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Antigravity')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect.Antigravity" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Grok'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/Grok/Darkspyre.Inference.Connect.Grok/Darkspyre.Inference.Connect.Grok.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Grok')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.Grok')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect.Grok" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.OpenAiApi'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/OpenAiApi/Darkspyre.Inference.Connect.OpenAiApi/Darkspyre.Inference.Connect.OpenAiApi.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.OpenAiApi')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.OpenAiApi')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect.OpenAiApi" />
  </ItemGroup>
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.SelfHost'))' != ''">
    <_InferenceSourceProject Include="$(_InferenceSourceRoot)Connect/src/SelfHost/Darkspyre.Inference.Connect.SelfHost/Darkspyre.Inference.Connect.SelfHost.csproj"
        ExcludeAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.SelfHost')->'%(ExcludeAssets)')"
        PrivateAssets="@(PackageReference->WithMetadataValue('Identity', 'Darkspyre.Inference.Connect.SelfHost')->'%(PrivateAssets)')" />
    <PackageReference Remove="Darkspyre.Inference.Connect.SelfHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="@(_InferenceSourceProject)">
      <Private Condition="'%(ExcludeAssets)' == 'runtime' or '%(ExcludeAssets)' == 'all'">false</Private>
      <ReferenceOutputAssembly Condition="'%(ExcludeAssets)' == 'all'">false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)ConnectDiscovery.targets" />
</Project>
