<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Darkspyre.Inference.Common" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect.Common" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect.Codex" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect.Claude" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect.Antigravity" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect.Grok" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect.OpenAiApi" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Connect.SelfHost" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.Common" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.Decision.Laya" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.Embedding" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.Embedding.Gemma" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.Ggml" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.Image.Supra" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.LLM.Qwen" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.Registry" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.Tensor.STT.Whisper" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.Inference.UI.Settings" Version="[$(Version)]" />
    <PackageReference Include="Darkspyre.TensorSharp.Backends.GGML.Native.osx-arm64"
                      Version="[$(VerifyGgmlNativeVersion)]" Condition="'$(VerifyGgmlNativeVersion)' != ''" />
  </ItemGroup>
  <Import Project="VerifyOutputPaths.targets" />
</Project>
