<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="DarkspyrePrivate" value="https://nuget.pkg.github.com/DarkspyreStudios/index.json" />
    <add key="InferenceLocal" value="../../artifacts/packages" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /><package pattern="Darkspyre.ML.Tokenizers" /></packageSource>
    <packageSource key="DarkspyrePrivate"><package pattern="Darkspyre.*" /></packageSource>
    <packageSource key="InferenceLocal"><package pattern="Darkspyre.Inference.*" /></packageSource>
  </packageSourceMapping>
</configuration>
