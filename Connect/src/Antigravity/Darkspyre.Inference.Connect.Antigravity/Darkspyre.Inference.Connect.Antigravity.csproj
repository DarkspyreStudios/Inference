<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Universal conversations through the Antigravity CLI provider.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
    <ProjectReference Include="../../HostTools/Darkspyre.Inference.Connect.HostTools/Darkspyre.Inference.Connect.HostTools.csproj" />
    <ProjectReference Include="../../HostTools/Darkspyre.Inference.Connect.HostTools.Mcp/Darkspyre.Inference.Connect.HostTools.Mcp.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.LLM.Tests" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.ConsoleTester" />
    <None Include="../../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="buildTransitive/Darkspyre.Inference.Connect.Antigravity.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!--
    AGY starts the host-tools MCP program from hosttools/mcp/ beside this library: the files of the program's output
    folder, apphost and dependencies included. The program's output is flat, and its subfolders are not part of it: a
    runtime-specific build of the program writes a <rid>/ subfolder, such as win-x64/, holding a whole self-contained
    runtime, and hosttools/service is the service package, which the program uses from the sibling hosttools/service/. It
    runs after AssignTargetPaths, so a build and a no-build publish both carry it.
  -->
  <Target Name="AddHostToolsMcpProgram" AfterTargets="AssignTargetPaths">
    <MSBuild Projects="../../HostTools/Darkspyre.Inference.Connect.HostTools.Mcp/Darkspyre.Inference.Connect.HostTools.Mcp.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_HostToolsMcpAssembly" />
    </MSBuild>
    <PropertyGroup>
      <_HostToolsMcpOutput>@(_HostToolsMcpAssembly->'%(RootDir)%(Directory)')</_HostToolsMcpOutput>
    </PropertyGroup>
    <ItemGroup>
      <_HostToolsMcpFile Include="$(_HostToolsMcpOutput)*" />
      <ContentWithTargetPath Include="@(_HostToolsMcpFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
        <TargetPath>hosttools/mcp/%(_HostToolsMcpFile.Filename)%(_HostToolsMcpFile.Extension)</TargetPath>
      </ContentWithTargetPath>
    </ItemGroup>
  </Target>
</Project>
