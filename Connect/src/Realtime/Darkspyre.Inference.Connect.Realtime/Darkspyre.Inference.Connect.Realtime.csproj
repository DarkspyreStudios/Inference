<Project Sdk="Microsoft.NET.Sdk">
  <!-- Realtime voice uses this project; realtime voice is out of the build (this project is outside the solution, the
       package and the source references). Its source stays unchanged and rejoins the build when the capability returns. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>Darkspyre.Inference.Connect.Realtime</AssemblyName>
    <Description>Typed realtime voice connections, session opening and provider-owned configuration.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Realtime.Tests" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="../../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
  </ItemGroup>
</Project>
