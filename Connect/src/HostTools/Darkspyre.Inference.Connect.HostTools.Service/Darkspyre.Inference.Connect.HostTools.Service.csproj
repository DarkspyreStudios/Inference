<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(DarkspyreCommonSourceRoot)/build/LocalServices/ServicePlatform.props" />
  <PropertyGroup>
    <Description>The host-tools local service: routes agent CLI tool calls to the host session that owns them.</Description>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>darkspyre-host-tools-service</AssemblyName>
    <!-- Project references can remove the caller's RID. The executable still targets the selected service runtime. -->
    <RuntimeIdentifier>$(ServiceRuntimeIdentifier)</RuntimeIdentifier>
    <!-- Restores every runtime the HostTools package carries a service for, so packing builds each without a restore. -->
    <RuntimeIdentifiers>$(HostToolsRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Darkspyre.Inference.Connect.HostTools.Contracts/Darkspyre.Inference.Connect.HostTools.Contracts.csproj" />
    <ProjectReference Include="$(DarkspyreCommonSourceRoot)/src/Darkspyre.LocalServices/Darkspyre.LocalServices.csproj" />
    <ProjectReference Include="$(DarkspyreCommonSourceRoot)/src/Darkspyre.LocalServices.Platform.MacOS/Darkspyre.LocalServices.Platform.MacOS.csproj" />
    <ProjectReference Include="$(DarkspyreCommonSourceRoot)/src/Darkspyre.LocalServices.Platform.Linux/Darkspyre.LocalServices.Platform.Linux.csproj" />
    <ProjectReference Include="$(DarkspyreCommonSourceRoot)/src/Darkspyre.LocalServices.Platform.Windows/Darkspyre.LocalServices.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
