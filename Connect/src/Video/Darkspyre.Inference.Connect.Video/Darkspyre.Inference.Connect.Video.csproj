<Project Sdk="Microsoft.NET.Sdk">
  <!-- Video generation uses this project; it is out of the build (this project is outside the solution, the package and
       the source references). Its source stays unchanged and rejoins the build when the capability returns. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>Darkspyre.Inference.Connect.Video</AssemblyName>
    <Description>Explicit video provider connections, scoped jobs, downloads and caller-resource materialization.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="../../../../Common/src/Darkspyre.Inference.Common/Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="../../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Video.Tests" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Resources" />
  </ItemGroup>
</Project>
