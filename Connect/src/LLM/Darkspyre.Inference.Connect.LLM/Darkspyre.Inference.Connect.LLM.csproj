<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Darkspyre.Inference.Connect.LLM</PackageId>
    <AssemblyName>Darkspyre.Inference.Connect.LLM</AssemblyName>
    <Description>Provider-neutral .NET client for OpenAI, compatible chat APIs, Anthropic, direct ChatGPT subscriptions, Claude and Antigravity CLIs, host-executed tools, managed and native agent sessions, structured output, streaming, model discovery, account usage, and embeddings.</Description>
    <PackageTags>llm;ai;openai;anthropic;claude;codex;gemini;antigravity;tool-use;structured-output</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
