<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport generates unsafe marshalling code for the process-group kill in CliProcessTermination. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Darkspyre.Inference.Connect.LLM</AssemblyName>
    <Description>Provider-neutral .NET client for OpenAI, compatible chat APIs, Anthropic, direct ChatGPT subscriptions, Claude and Antigravity CLIs, host-executed tools, managed and native agent sessions, structured output, streaming, model discovery, account usage, and embeddings.</Description>
    <PackageTags>llm;ai;openai;anthropic;claude;codex;gemini;antigravity;tool-use;structured-output</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Darkspyre.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <!-- O200kBase depends on a vulnerable Microsoft.Bcl.Memory. The central transitive pin does not reach a project that
         references this one, so the direct reference carries the patched version to source-mode consumers. -->
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Image" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.STT" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Video" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Realtime" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Resources" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.TTS" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Audio" />
  </ItemGroup>

</Project>
