<Project Sdk="Microsoft.NET.Sdk">
  <!-- L2 exception: phase 1 of the conversation contract leaves this project out of the solution, the package and the
       source references. Its source stays unchanged and rejoins the build when its provider returns. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>Darkspyre.Inference.Connect.LLM.Bedrock</AssemblyName>
    <Description>AWS Bedrock Converse and AgentCore Harness transports for Darkspyre.Inference.Connect.LLM.</Description>
    <PackageTags>llm;ai;aws;bedrock;agentcore</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.LLM.Bedrock.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.Bedrock" />
    <PackageReference Include="AWSSDK.BedrockAgentCore" />
    <PackageReference Include="AWSSDK.BedrockRuntime" />
    <PackageReference Include="AWSSDK.Core" />
    <PackageReference Include="AWSSDK.SecurityToken" />
  </ItemGroup>

</Project>
