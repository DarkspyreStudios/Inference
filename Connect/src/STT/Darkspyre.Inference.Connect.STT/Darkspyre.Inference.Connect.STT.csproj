<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hosted speech transcription uses this project; it is out of the build (this project is outside the solution, the
       package and the source references). Its source stays unchanged and rejoins the build when the capability returns. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>Darkspyre.Inference.Connect.STT</AssemblyName>
    <Description>Provider-neutral hosted speech-transcription bindings and settings.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.STT.Tests" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="../../../../Common/src/Darkspyre.Inference.Common/Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="../../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
  </ItemGroup>
</Project>
