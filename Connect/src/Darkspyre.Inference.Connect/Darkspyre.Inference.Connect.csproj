<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Darkspyre.Inference.Connect</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <Description>Image, speech and audio inference connectors for Darkspyre applications.</Description>
    <PackageTags>ai;inference;image-generation;audio;speech;comfyui</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="..\Image\Darkspyre.Inference.Connect.Image\Darkspyre.Inference.Connect.Image.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\TTS\Darkspyre.Inference.Connect.TTS\Darkspyre.Inference.Connect.TTS.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Audio\Darkspyre.Inference.Connect.Audio\Darkspyre.Inference.Connect.Audio.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Darkspyre.ML.Tokenizers" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.ML.Tokenizers" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\Audio\Darkspyre.Inference.Connect.Audio\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Connect.Audio.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Audio\Darkspyre.Inference.Connect.Audio\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Connect.Audio.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\TTS\Darkspyre.Inference.Connect.TTS\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Connect.TTS.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\TTS\Darkspyre.Inference.Connect.TTS\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Connect.TTS.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Image\Darkspyre.Inference.Connect.Image\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Connect.Image.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\Image\Darkspyre.Inference.Connect.Image\bin\$(Configuration)\$(TargetFramework)\Darkspyre.Inference.Connect.Image.xml" Pack="true" PackagePath="lib\$(TargetFramework)" />
  </ItemGroup>
</Project>
