<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LibraryImport generates unsafe marshalling code for the process-group kill in CliProcessTermination. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Darkspyre.Inference.Connect.Common</AssemblyName>
    <Description>Provider-neutral .NET client for OpenAI, compatible chat APIs, Anthropic, direct ChatGPT subscriptions, Claude and Antigravity CLIs, host-executed tools, managed and native agent sessions, structured output, streaming, model discovery, account usage, and embeddings.</Description>
    <PackageTags>llm;ai;openai;anthropic;claude;codex;gemini;antigravity;tool-use;structured-output</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Darkspyre.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <!-- O200kBase depends on a vulnerable Microsoft.Bcl.Memory. The central transitive pin does not reach a project that
         references this one, so the direct reference carries the patched version to source-mode consumers. -->
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Image" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.TTS" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Audio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build has only the Codex, Claude CLI and OpenAI API providers. Excluded source stays in the repository. -->
    <Compile Remove="Providers/Anthropic*.cs;Providers/ManagedAnthropicAgentClient.cs" />
    <Compile Remove="Providers/Antigravity*.cs;Providers/IAntigravityCliRunner.cs" />
    <Compile Remove="Providers/Apple*.cs;Providers/ManagedAppleAgentClient.cs" />
    <Compile Remove="Providers/ChatCompletionsLlmClientBase.cs;Providers/OpenAiCompatibleChatLlmClient.cs;Providers/ManagedOpenAiCompatibleAgentClient.cs" />
    <Compile Remove="Providers/GeminiApiLlmClient*.cs;Providers/ManagedGeminiApiAgentClient.cs" />
    <Compile Remove="Providers/Xai*.cs;Providers/ManagedXaiAgentClient.cs" />
    <Compile Remove="Internal/AnthropicContentStream.cs;Internal/AnthropicProgrammaticSchemas.cs;Internal/AnthropicPromptCache.cs;Internal/AnthropicSchemas.cs;Internal/AnthropicToolContinuation.cs;Internal/AnthropicTools.cs" />
    <Compile Remove="Internal/ChatReasoning.cs;Internal/OpenAiCompatibleChatContinuationCodec.cs;Internal/OpenRouter*.cs;Internal/ProviderTokenCounting.cs" />
    <Compile Remove="Internal/Gemini/**" />
    <Compile Include="Internal/Gemini/GeminiCacheBindings.cs;Internal/Gemini/GoogleCacheData.cs" />
    <Compile Remove="Internal/Xai*.cs;Internal/DocumentSearchEnumConverters.cs" />
    <Compile Remove="DocumentSearch.cs;XaiFamilyBinding.cs;XaiFileStorageOptions.cs;XaiHostedTools.cs;XaiSkills.cs;LlmProviderService.Xai.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="README.md" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Codex" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Claude" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.OpenAiApi" />
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.SelfHost" />
  </ItemGroup>
</Project>
