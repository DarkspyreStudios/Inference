    <None Include="buildTransitive/Darkspyre.Inference.Connect.Claude.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icons/*.svg" LogicalName="Icons/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
