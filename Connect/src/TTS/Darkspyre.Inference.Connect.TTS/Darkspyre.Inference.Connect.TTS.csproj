<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Description>Typed external text-to-speech connections with PocketTTS HTTP support.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.TTS.Tests" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="../../../../Common/src/Darkspyre.Inference.Common/Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="../../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- xAI text-to-speech uses these files; the xAI transport is out of the build. Its source stays in the repository,
         unchanged, and moves into that provider's own library when the provider returns to the build. -->
    <Compile Remove="XaiTts*.cs" />
  </ItemGroup>
</Project>
