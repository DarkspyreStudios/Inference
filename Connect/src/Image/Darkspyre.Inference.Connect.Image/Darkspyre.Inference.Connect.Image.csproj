<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AssemblyName>Darkspyre.Inference.Connect.Image</AssemblyName>
    <Description>Provider-neutral image-generation connections with ComfyUI workflow, job, progress, download, and cancellation support.</Description>
    <PackageTags>ai;image-generation;comfyui;websocket</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Common\src\Darkspyre.Inference.Common\Darkspyre.Inference.Common.csproj" />
    <ProjectReference Include="../../Common/Darkspyre.Inference.Connect.Common/Darkspyre.Inference.Connect.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Darkspyre.Inference.Connect.Image.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- L2 exception: phase 1 leaves the xAI transport out of the build. Its source stays in the repository, unchanged,
         and rejoins the build when the xAI provider returns. -->
    <Compile Remove="Internal/XaiImageProtocol.cs;Providers/XaiImagineImageTransport.cs" />
  </ItemGroup>

</Project>
