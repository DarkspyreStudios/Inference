<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!-- The upstream TensorSharp release Darkspyre runs on. Changing it is the whole version change. -->
    <TensorSharpVersion>2026.10.11</TensorSharpVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.76.0" />
    <PackageVersion Include="AWSSDK.Bedrock" Version="4.0.100.5" />
    <PackageVersion Include="AWSSDK.BedrockAgentCore" Version="4.0.111" />
    <PackageVersion Include="AWSSDK.BedrockRuntime" Version="4.0.100.5" />
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.6" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.5" />
    <PackageVersion Include="Darkspyre.SecureStore" Version="1.0.0" />
    <PackageVersion Include="Darkspyre.ML.Tokenizers" Version="2.0.1.1" />
    <PackageVersion Include="TensorSharp.Backends.Cuda" Version="$(TensorSharpVersion)" />
    <PackageVersion Include="TensorSharp.Backends.GGML" Version="$(TensorSharpVersion)" />
    <PackageVersion Include="TensorSharp.Backends.MLX" Version="$(TensorSharpVersion)" />
    <PackageVersion Include="TensorSharp.Chat" Version="$(TensorSharpVersion)" />
    <PackageVersion Include="TensorSharp.Models" Version="$(TensorSharpVersion)" />
    <PackageVersion Include="TensorSharp.Runtime" Version="$(TensorSharpVersion)" />
    <PackageVersion Include="TensorSharp.Tensors" Version="$(TensorSharpVersion)" />
    <PackageVersion Include="StbImageSharp" Version="2.30.15" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageVersion Include="NAudio.Core" Version="2.2.1" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.EP.WebGpu" Version="0.4.0" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Cuda12.Linux" Version="1.9.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>
</Project>
